    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Muslim Clock"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Demande d'autorisation localisation (Qiblah, horaires, météo).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحتاج إلى موقعك لتحديد اتجاه القبلة وعرض الطقس."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need your location for the Qiblah direction and weather."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons besoin de votre position pour la Qiblah et la météo."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Demande d'autorisation micro (enregistrement de récitation).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتسجيل تلاوتك للقرآن وتحليلها على جهازك، ومشاركتها إن شئت (مثلاً مع إمامك للمراجعة)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To record your Quran recitation, analyze it on your device and, if you wish, share it (for example with your imam for review)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour enregistrer ta récitation du Coran, l'analyser sur ton appareil et, si tu le souhaites, la partager (par exemple à ton imam pour relecture)."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للتعرّف على الآية التي تتلوها والتحقق من تلاوتك كلمةً كلمة. يتم التحليل على جهازك فقط، ولا يُرسَل صوتك أبداً."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To recognize the verse you recite and check your recitation word by word. The analysis happens only on your device: your voice is never sent anywhere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour reconnaître le verset que tu récites et vérifier ta récitation mot à mot. L'analyse se fait uniquement sur ton appareil : ta voix n'est jamais envoyée."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
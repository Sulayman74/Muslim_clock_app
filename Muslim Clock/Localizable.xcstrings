    "Récite de mémoire, puis réécoute-toi en lisant le texte pour te corriger." : {
      "comment" : "A description of the recording process.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ من حفظك، ثم استمع إلى تسجيلك وأنت تقرأ النص لتصحّح نفسك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recite from memory, then listen back while reading the text to correct yourself."

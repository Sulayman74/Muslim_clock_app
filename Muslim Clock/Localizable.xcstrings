            "value" : "لا تُجدول الإشعارات إلا للصلوات **القادمة**: إذا كان الفجر والعصر قد مضيا اليوم، فستصلك غدًا صباحًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are only scheduled for **upcoming** prayers: if Fajr and Asr have already passed today, they'll arrive tomorrow morning."
          }
        }
      }
    },

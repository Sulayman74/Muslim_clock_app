    "Tes pages n'ont pas pu être sauvegardées. Réessaie, et relance l'app si le problème persiste.": {
      "comment": "A message displayed when a log attempt fails.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ صفحاتك. حاول مجددًا، وأعد تشغيل التطبيق إذا استمرت المشكلة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pages couldn't be saved. Try again, and restart the app if the problem persists."

    "Jours Blancs — Jeûne recommandé (13-14-15)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأيام البيض — صيام مستحب (١٣-١٤-١٥)"

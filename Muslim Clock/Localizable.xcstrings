    "Takbir d'Arafah à dire à voix haute du Fajr du 9 au Asr du 13 Dhul-Hijjah.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكبير عرفة يُجهر به من فجر يوم ٩ إلى عصر يوم ١٣ من ذي الحجة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takbir of Arafah, said aloud from Fajr on the 9th until Asr on the 13th of Dhul-Hijjah."
          }
        }
      }
    },
    "Takbir muqayyad à voix haute après chaque prière obligatoire, du Fajr du 9 jusqu'à Asr du 13.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التكبير المقيَّد جهرًا بعد كل صلاة مفروضة، من فجر اليوم التاسع إلى عصر اليوم الثالث عشر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restricted Takbir out loud after every obligatory prayer, from Fajr on the 9th until Asr on the 13th."
          }
        }
      }
    },
    "Tape au moins 3 mots du verset": {
      "comment": "A description of the minimum number of words that must be entered in the search bar to display verse search results.",
      "isCommentAutoGenerated": true,
      "localizations": {

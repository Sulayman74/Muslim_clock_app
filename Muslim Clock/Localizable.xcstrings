    "Verset %lld : « %@ » a été entendu à la place de « %@ ». Vérifie ce mot dans le texte." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الآية %lld: سُمِعت « %@ » بدلًا من « %@ ». تحقّق من هذه الكلمة في النص."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verse %lld: “%@” was heard instead of “%@”. Check this word in the text."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Verset %1$lld : « %2$@ » a été entendu à la place de « %3$@ ». Vérifie ce mot dans le texte."
          }
        }
      }
    },
    "Verset %lld : « %@ » a été entendu en trop. Vérifie que ce mot fait bien partie du passage." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الآية %lld: سُمِعت « %@ » زيادةً. تحقّق من أن هذه الكلمة من المقطع فعلًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verse %lld: “%@” was heard as an extra word. Check that this word is really part of the passage."
